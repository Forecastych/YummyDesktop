{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YummyAnime Desktop",
  "version": "0.3.7-c",
  "identifier": "io.github.yummidesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YummyAnime Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#222222",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob: http://yimg.localhost yimg:",
        "media-src": "'self' https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.yani.tv wss://socket1.yani.tv wss://socket2.yani.tv wss://socket3.yani.tv",
        "frame-src": "https: http://cvh.localhost cvh:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Неофициальный десктоп-клиент YummyAnime",
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3QTUwRDYzOTUxRjM0RkEKUldUNk5CK1ZZdzJsZC8vQnNtakN6ZlJCeE5zclVLaTdMKytSWks0L3FZVEhQK0FSdVpsTVFKbHAK",
      "endpoints": [
        "https://github.com/Forecastych/YummyDesktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
