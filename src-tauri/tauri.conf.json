{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YummyDesktop",
  "version": "0.1.0",
  "identifier": "io.github.yummidesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YummyAnime Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#222222"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob:",
        "media-src": "'self' https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.yani.tv",
        "frame-src": "https: http://cvh.localhost cvh:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Неофициальный десктоп-клиент YummyAnime",
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
